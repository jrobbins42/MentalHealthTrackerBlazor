@using Microsoft.AspNetCore.Components
@inject NavigationManager NavigationManager

@code {
    protected override void OnInitialized()
    {
        // Login lives at the app root (Components/Pages/Login.razor).
        var returnUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        // Already at the login page: don't redirect again and risk a loop.
        if (string.IsNullOrEmpty(returnUrl))
        {
            return;
        }

        // The login handler validates this again before redirecting, so it can only ever be a
        // path inside this application.
        NavigationManager.NavigateTo($"/?returnUrl={Uri.EscapeDataString("/" + returnUrl)}", forceLoad: true);
    }
}
